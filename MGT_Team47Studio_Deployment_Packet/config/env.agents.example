# Environment variables for the local agent plane. Names only: set the values in Windows
# (Settings > System > About > Advanced system settings > Environment Variables, user scope).
# Never commit a filled copy.

# --- t47 ---
# Optional: full path to config\t47.toml
T47_CONFIG=
# Optional: your name as recorded on submit and export (default: Windows login name)
T47_OPERATOR=
# 64 hex characters. Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Keep a copy in the password manager. Without it a backup cannot be restored.
T47_BACKUP_KEY=
# Only if [ollama_cloud] enabled = true, after gate G12 is accepted
OLLAMA_CLOUD_API_KEY=

# --- Ollama server (values recorded in infra/portal/env.local-rtx5080.example) ---
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=10m

// Team 47 Studio: OpenClaw fragment for the local operations agents (drafts only).
// Generated by `t47 openclaw render`. Merge into ~/.openclaw/openclaw.json by hand; do not replace your file.
// After merging: `openclaw doctor`, then the security audit (docs.openclaw.ai/gateway/security/running-the-audit).
// These agents can call three tools from the t47 MCP server: list agents, create a draft, read the queue.
// They cannot run commands, browse, write files, send messages, schedule jobs or approve their own drafts.
{
  "models": {
    "providers": {
      "ollama": {
        "apiKey": "ollama-local",
        "baseUrl": "http://127.0.0.1:11434",
        "api": "ollama",
        "timeoutSeconds": 300,
        "models": [
          {
            "id": "qwen3.5:4b",
            "name": "qwen3.5:4b",
            "params": {
              "keep_alive": "10m"
            }
          },
          {
            "id": "deepseek-r1:8b",
            "name": "deepseek-r1:8b",
            "params": {
              "keep_alive": "10m"
            }
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "sandbox": {
        "mode": "all"
      }
    },
    "entries": {
      "t47-ops": {
        "name": "Team 47 Studio Ops (drafts only)",
        "workspace": "~/.openclaw/workspace-t47",
        "model": {
          "primary": "ollama/qwen3.5:4b",
          "fallbacks": [
            "ollama/deepseek-r1:8b"
          ]
        },
        "sandbox": {
          "mode": "all"
        },
        "tools": {
          "profile": "minimal",
          "deny": [
            "exec",
            "browser",
            "canvas",
            "group:fs",
            "group:messaging",
            "group:automation",
            "group:nodes"
          ]
        }
      },
      "t47-strategy": {
        "name": "Team 47 Studio Strategy (drafts only)",
        "workspace": "~/.openclaw/workspace-t47",
        "model": {
          "primary": "ollama/deepseek-r1:8b",
          "fallbacks": [
            "ollama/qwen3.5:4b"
          ]
        },
        "sandbox": {
          "mode": "all"
        },
        "tools": {
          "profile": "minimal",
          "deny": [
            "exec",
            "browser",
            "canvas",
            "group:fs",
            "group:messaging",
            "group:automation",
            "group:nodes"
          ]
        }
      }
    }
  },
  "tools": {
    "deny": [
      "exec",
      "browser",
      "canvas",
      "group:fs",
      "group:messaging",
      "group:automation",
      "group:nodes"
    ],
    "elevated": {
      "enabled": false
    },
    "openclaw": {
      "autoApproveChanges": false
    },
    "sandbox": {
      "tools": {
        "allow": [
          "bundle-mcp"
        ]
      }
    }
  },
  "mcp": {
    "servers": {
      "t47": {
        "command": "python",
        "args": [
          "-m",
          "t47",
          "mcp",
          "serve"
        ]
      }
    }
  }
}

diff --git a/.github/workflows/deployment-packet.yml b/.github/workflows/deployment-packet.yml
new file mode 100644
index 0000000..95a32af
--- /dev/null
+++ b/.github/workflows/deployment-packet.yml
@@ -0,0 +1,28 @@
+name: deployment-packet
+
+# Runs the t47 packet's own tests when the packet changes. No secrets, no deploy, read-only token.
+on:
+  pull_request:
+    paths: ["MGT_Team47Studio_Deployment_Packet/**"]
+  push:
+    branches: ["codex/**", "packet/**"]
+    paths: ["MGT_Team47Studio_Deployment_Packet/**"]
+
+permissions:
+  contents: read
+
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    defaults:
+      run:
+        working-directory: MGT_Team47Studio_Deployment_Packet
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - name: Create a virtual environment with the runner's Python
+        run: python3 -m venv .venv && .venv/bin/python -m pip install -e ".[dev]"
+      - name: Unit tests
+        run: .venv/bin/python -m pytest
+      - name: Manifest
+        run: sha256sum -c MANIFEST.sha256 --quiet

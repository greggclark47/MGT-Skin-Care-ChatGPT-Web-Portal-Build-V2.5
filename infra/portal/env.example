# Copy to an environment file outside source control. Never put secrets in NEXT_PUBLIC variables.
NODE_ENV=production
DEMO_MODE=false
PUBLIC_ORIGIN=https://YOUR-PORTAL-HOST
HOST=0.0.0.0
PORT=3100
# Use the designated project connection; API and worker must use the same database.
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE:5432/postgres?sslmode=verify-full
PORTAL_AUTO_MIGRATE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-first AI runtime. Ollama is the primary backend for routine and coach workloads.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_PARALLEL=2
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MODEL_PRIMARY=llama3.2:3b
OLLAMA_MODEL_REASONING=deepseek-r1:8b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# Optional OpenClaw orchestration through Ollama's native API.
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=http://127.0.0.1:11434
OPENCLAW_API_MODE=ollama
# Only required for OPENCLAW_API_MODE=openai-completions. Native Ollama mode needs no key.
OPENCLAW_API_KEY=

# Hosted escalation only; keep the secret server-side and unset to stay local-only.
# The task registry chooses Sol (medium) for premium consultations, Astra (high)
# for deep routine optimization, and Sol (low) for entitled local fallbacks.
# A ChatGPT subscription does not supply an API key or API credits.
OPENAI_API_KEY=

SUBSCRIPTIONS_ENABLED=false
SUBSCRIPTION_TERMS_APPROVED=false
# Use false with sandbox keys in staging; set true only for an approved production launch.
STRIPE_LIVE_MODE=false
STRIPE_SECRET_KEY=
STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=

PORTAL_DOMAIN=

# Pin every production container image to an approved immutable digest.
NODE_IMAGE=node@sha256:REPLACE_WITH_APPROVED_DIGEST
API_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_API_IMAGE@sha256:REPLACE_WITH_APPROVED_DIGEST
WEB_IMAGE=ghcr.io/REPLACE_WITH_APPROVED_WEB_IMAGE@sha256:REPLACE_WITH_APPROVED_DIGEST
OLLAMA_IMAGE=ollama/ollama@sha256:REPLACE_WITH_APPROVED_DIGEST
CADDY_IMAGE=caddy@sha256:REPLACE_WITH_APPROVED_DIGEST

# Operations worker: the default creates durable in-app notifications only.
WORKER_INTERVAL_SECONDS=60
WORKER_READINESS_MAX_AGE_SECONDS=300
WORKER_HEALTH_FILE=/tmp/mgt-worker-health.json
NOTIFICATION_DELIVERY=in_app
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Required production ownership/evidence. These are non-secret references;
# keep detailed staffing docs and accessibility reports in the approved system of record.
SUPPORT_OWNER_NAME=REPLACE_WITH_ACCOUNTABLE_SUPPORT_OWNER
SUPPORT_OWNER_EMAIL=support-owner@example.com
ACCESSIBILITY_VALIDATION_REPORT_URL=https://REPLACE_WITH_DEPLOYED_ACCESSIBILITY_REPORT_URL
ACCESSIBILITY_VALIDATED_AT=REPLACE_WITH_PAST_ISO_TIMESTAMP

# Operator-visible service ownership. These URLs must be non-secret HTTPS locations.
MONITORING_DASHBOARD_URL=https://REPLACE_WITH_MONITORING_DASHBOARD
INCIDENT_RUNBOOK_URL=https://REPLACE_WITH_INCIDENT_RUNBOOK
ALERT_OWNER_EMAIL=alert-owner@example.com
SUPPORT_RESPONSE_TARGET_HOURS=24
OPERATIONS_ALERT_DELIVERY=webhook
OPERATIONS_ALERT_WEBHOOK_URL=https://REPLACE_WITH_OPERATIONS_ALERT_ENDPOINT
OPERATIONS_ALERT_WEBHOOK_TOKEN=
# Milliseconds. The receiver should validate x-mgt-timestamp and
# x-mgt-signature (HMAC SHA-256 over "timestamp.rawBody") before accepting.
OPERATIONS_ALERT_TIMEOUT_MS=10000
OPERATIONS_ALERT_RETRY_COOLDOWN_SECONDS=300
OPERATIONS_ALERT_MAX_ATTEMPTS=5
# Non-secret key identifier for receiver key rotation. The token itself remains secret.
OPERATIONS_ALERT_KEY_ID=primary
OPERATIONS_ALERT_EVENT_RETENTION_DAYS=90
# Receiver contract: deduplicate on x-mgt-delivery-id, require x-mgt-attempt,
# require x-mgt-event=operations.alert and x-mgt-signature-version=v1, then verify
# x-mgt-signature against timestamp.rawBody within a short replay window. Do not
# expect the shared secret in an Authorization header; key identity is x-mgt-key-id.

OPERATIONS_AI_LOG_RETENTION_DAYS=30
OPERATIONS_NOTIFICATION_RETENTION_DAYS=90
OPERATIONS_BILLING_RETENTION_DAYS=730
OPERATIONS_WEBHOOK_RECEIPT_RETENTION_DAYS=90
OPERATIONS_AGGREGATE_METRIC_RETENTION_DAYS=180
OPERATIONS_DELETION_PROOF_RETENTION_DAYS=730
OPERATIONS_RUN_RETENTION_DAYS=90

# An encrypted, off-host backup process must report its successful verification here.
# The worker marks readiness unhealthy when the last verified backup exceeds this age.
BACKUP_MAX_AGE_HOURS=26
# A successful isolated restore drill must remain within this age window.
BACKUP_RESTORE_MAX_AGE_DAYS=90

# The locked consumer Premium offer. Both rates are required before subscription
# enrollment can be enabled; use IDs from the same mode as STRIPE_LIVE_MODE.
STRIPE_PREMIUM_PRODUCT_ID=
STRIPE_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_PREMIUM_ANNUAL_PRICE_ID=

# Team 47 Studio local development profile for the observed RTX 5080 (16 GB VRAM).
# Copy to an ignored local environment file. Never place real keys in Git or Google Drive.
NODE_ENV=development
DEMO_MODE=false
PUBLIC_ORIGIN=http://127.0.0.1:3100

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_KEEP_ALIVE=10m
OLLAMA_MODEL_PRIMARY=deepseek-r1:8b
OLLAMA_MODEL_SECONDARY=qwen3.5:4b
OLLAMA_MODEL_REASONING=deepseek-r1:8b
OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# Enable only after the separate OpenClaw runtime and its tool policy are installed and reviewed.
OPENCLAW_ENABLED=false
OPENCLAW_BASE_URL=http://127.0.0.1:11434
OPENCLAW_API_MODE=ollama
OPENCLAW_API_KEY=

# GPT-5 is an explicitly temporary, deprecated final fallback. Keep off until the
# server-side key, billing cap, hosted-processing consent and migration approval exist.
HOSTED_OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL_FINAL_FALLBACK=gpt-5

# Supabase Google sign-in is ready in code but remains off until these project values
# are injected from a local secret store or Google Secret Manager.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_GOOGLE_OAUTH_ENABLED=false

{
  "name": "mgt-skincare-v2",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "pnpm -r build",
    "build:static": "node infra/portal/build-static.cjs",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "migrate": "node infra/db/migrate.js",
    "infra:preflight": "node --env-file-if-exists=infra/portal/.env infra/portal/preflight.mjs",
    "infra:readiness": "node --env-file-if-exists=infra/portal/.env infra/portal/release-readiness.mjs",
    "infra:ship-packet": "node --env-file-if-exists=infra/portal/.env infra/portal/ship-packet.mjs",
    "infra:create-ship-packet": "node --env-file-if-exists=infra/portal/.env infra/portal/create-ship-packet.mjs",
    "infra:staging-probe": "node infra/portal/staging-probe.mjs",
    "infra:staging-artifacts": "node infra/portal/staging-artifacts.mjs",
    "infra:staging-review": "node infra/portal/staging-evidence-review.mjs",
    "infra:staging-handoff": "node infra/portal/staging-promotion-handoff.mjs",
    "infra:staging-authorization": "node infra/portal/staging-promotion-authorization.mjs",
    "infra:staging-execution-review": "node infra/portal/staging-execution-review.mjs",
    "infra:production-gate": "node infra/portal/production-gate.mjs",
    "infra:production-evidence": "node infra/portal/production-evidence.mjs",
    "infra:release-export": "node infra/portal/release-export.mjs",
    "reconcile:migrations": "node infra/db/migration-lineage.mjs",
    "test:compose-contract": "node --test infra/portal/compose-contract.test.mjs",
    "test:ci-contract": "node --test infra/portal/ci-contract.test.mjs",
    "test:compliance-contract": "node --test infra/portal/compliance-contract.test.mjs",
    "test:staging-evidence": "node --test infra/portal/staging-evidence.test.mjs",
    "test:staging-pipeline": "node --test infra/portal/staging-pipeline.test.mjs",
    "test:staging-artifacts": "node --test infra/portal/staging-artifacts.test.mjs",
    "test:staging-authorization": "node --test infra/portal/staging-promotion-authorization.test.mjs",
    "test:staging-execution-review": "node --test infra/portal/staging-execution-review.test.mjs",
    "test:production-gate": "node --test infra/portal/production-gate.test.mjs",
    "test:production-evidence": "node --test infra/portal/production-evidence.test.mjs",
    "test:release-export": "node --test infra/portal/release-export.test.mjs",
    "test:infra": "node --test infra/portal/preflight.test.mjs infra/portal/release-readiness.test.mjs infra/portal/ship-plan.test.mjs infra/portal/ship-packet.test.mjs infra/portal/create-ship-packet.test.mjs infra/portal/demo-contract.test.mjs infra/portal/compliance-contract.test.mjs infra/portal/staging-evidence.test.mjs infra/portal/staging-pipeline.test.mjs infra/portal/staging-artifacts.test.mjs infra/portal/staging-promotion-authorization.test.mjs infra/portal/staging-execution-review.test.mjs infra/portal/production-gate.test.mjs infra/portal/production-evidence.test.mjs infra/portal/release-export.test.mjs",
    "test:lineage": "node --test infra/db/migration-lineage.test.mjs",
    "test:golden": "pnpm --filter @mgt/domain build && node --test packages/shared/test/golden-cases.cjs",
    "test:analytics": "pnpm --filter @mgt/analytics-sdk test",
    "test:mobile-contract": "pnpm --filter @mgt/mobile test:contract",
    "release:checkpoint": "node infra/portal/local-checkpoint.cjs",
    "test:verification": "node infra/portal/verify.cjs"
  }
}
